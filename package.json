{
  "name": "homebridge-eufy-nvr-gateway",
  "displayName": "Homebridge eufy NVR Gateway",
  "type": "module",
  "version": "0.3.0",
  "description": "Homebridge Camera FFmpeg, extended to wake battery eufy cameras behind the eufy-nvr-gateway while HomeKit watches them.",
  "author": {
    "name": "Khaos Tian"
  },
  "contributors": [
    {
      "name": "Sunoo"
    },
    {
      "name": "Khaos Tian"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbanky/homebridge-eufy-nvr-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/dbanky/homebridge-eufy-nvr-gateway/issues"
  },
  "homepage": "https://github.com/dbanky/homebridge-eufy-nvr-gateway#readme",
  "maintainers": [
    {
      "name": "Homebridge"
    }
  ],
  "keywords": [
    "homebridge-plugin",
    "camera",
    "ffmpeg",
    "homebridge",
    "eufy",
    "battery",
    "eufy-nvr-gateway"
  ],
  "main": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "config.schema.json",
    "dist/**/*",
    "package.json",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "homebridge": "^1.9.0 || ^2.0.0 || ^2.0.0-beta.26 || ^2.0.0-alpha.37",
    "node": "^20 || ^22 || ^24"
  },
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch": "npm run build && npm run plugin-ui && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "npm run clean && tsc && npm run plugin-ui",
    "prepublishOnly": "npm test && npm run build",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage"
  },
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "@homebridge/plugin-ui-utils": "^2.1.0",
    "mqtt": "5.14.1",
    "pick-port": "^2.1.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@types/aes-js": "^3.1.4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.5.2",
    "@types/semver": "^7.7.1",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.21.0",
    "eslint-plugin-format": "^1.0.1",
    "homebridge": "^1.11.0",
    "homebridge-config-ui-x": "5.6.1",
    "nodemon": "^3.1.10",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
